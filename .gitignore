# Credentials. configs/.gitignore already covers these; repeated here so the
# rule survives someone deleting that file. accounts.local.json holds real
# Ubisoft account passwords.
*.local.json

# Trained models and replay buffers. 16 GB, and a buffer is ~2 GB each.
models/

# Virtual environment (6.1 GB).
.venv/

# Run output: episode traces, split times, replays. Regenerated by training.
runs/
logs/

# Occupancy dumps and derived route caches are per-map and re-fetchable from
# the game in one command (tools/build_route.py). The hand-authored notes in
# maps/*.md ARE tracked - see the negations below.
maps/*.json

# ...but keep the measured findings, they are not reproducible without a human
# driving a test track.
!maps/names.json
!maps/*.md

# Recorded reference lines are large-ish and map-specific; the explorer
# regenerates them at handover.
lines/*.json

# Local scratch
_bak/
demos/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
nohup.out
