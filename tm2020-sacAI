#!/usr/bin/env bash
# One entry point. Brings up the plumbing and opens the panel; everything
# after that is chosen in the browser.
#
#   ./tm2020-sacAI                 one instance, panel on :8080
#   ./tm2020-sacAI --instances 3   three games feeding one model
#   ./tm2020-sacAI --status        what is running, then exit
#   ./tm2020-sacAI --stop          stop everything this started
#   ./tm2020-sacAI --mock 2        two fake games, for testing without Trackmania
#
# What it starts, per instance i:
#     pad server   8765 + 10i    system python - needs evdev and uinput
#     broker       8767 + 10i    fans the plugin's single client slot out
# and once, shared:
#     web panel    8080
#
# What it deliberately does NOT do: create Ubisoft accounts, or log in. One
# account can only be signed in once at a time, so N concurrent games need N
# accounts. Create them by hand, sign each in once inside its own Wine prefix,
# then snapshot the prefix. Scripting that login is the single thing most
# likely to get the accounts banned - a failed retry loop against Ubisoft's
# auth endpoint is indistinguishable from credential stuffing from their side.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"
PIDS="$ROOT/logs/sacAI.pids"
PANEL_PORT=8080
INSTANCES=1
MOCK=0
ACTION=start

while [[ $# -gt 0 ]]; do
  case "$1" in
    --instances|-n) INSTANCES="$2"; shift 2 ;;
    --mock)         MOCK="$2"; INSTANCES="$2"; shift 2 ;;
    --port)         PANEL_PORT="$2"; shift 2 ;;
    --status)       ACTION=status; shift ;;
    --stop)         ACTION=stop; shift ;;
    -h|--help)      sed -n '2,25p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 1 ;;
  esac
done

mkdir -p logs

# The pad server needs evdev and permission to create uinput devices, neither
# of which lives in the venv. Finding this now beats an ImportError several
# seconds after everything else has come up, which reads as "the game isn't
# responding".
SYS_PY=""
for c in /usr/bin/python3 "$(command -v python3 || true)"; do
  [[ -n "$c" ]] && "$c" -c 'import evdev' 2>/dev/null && { SYS_PY="$c"; break; }
done

track() { echo "$1" >> "$PIDS"; }

stop_all() {
  [[ -f "$PIDS" ]] || { echo "nothing tracked in $PIDS"; return 0; }
  while read -r pid; do
    [[ -n "$pid" ]] || continue
    if kill -0 "$pid" 2>/dev/null; then
      # SIGTERM, not SIGKILL: the trainer catches it and saves the model and
      # the replay buffer. The buffer is the expensive part - every transition
      # in it cost real seconds of real driving.
      kill -TERM "$pid" 2>/dev/null || true
      echo "stopped $pid"
    fi
  done < "$PIDS"
  rm -f "$PIDS"
}

status() {
  python3 tools/fleet.py --instances "$INSTANCES" --check || true
  echo
  if curl -sf "http://127.0.0.1:$PANEL_PORT/api/status" >/dev/null 2>&1; then
    echo "panel   http://127.0.0.1:$PANEL_PORT  up"
  else
    echo "panel   http://127.0.0.1:$PANEL_PORT  DOWN"
  fi
}

case "$ACTION" in
  stop)   stop_all; exit 0 ;;
  status) status; exit 0 ;;
esac

if [[ -f "$PIDS" ]]; then
  echo "already started (see $PIDS). Use --stop first, or --status." >&2
  exit 1
fi
: > "$PIDS"

echo "TM2020 AI driver — $INSTANCES instance(s)"
echo

if [[ "$MOCK" -gt 0 ]]; then
  # Fake games, so the multi-instance wiring can be exercised without N copies
  # of Trackmania and N Ubisoft accounts. The physics are a toy: this proves
  # the plumbing, it does not train anything worth keeping.
  for ((i = 0; i < MOCK; i++)); do
    ./.venv/bin/python tools/mock_game.py --instance "$i" \
        > "logs/mock$i.log" 2>&1 &
    track $!
    echo "  mock game $i"
  done
  sleep 1
else
  if [[ -z "$SYS_PY" ]]; then
    echo "no system python with evdev. Install it:  sudo pacman -S python-evdev" >&2
    exit 1
  fi
  python3 tools/fleet.py --instances "$INSTANCES" > logs/fleet.log 2>&1 &
  track $!
  echo "  fleet supervisor (pads + brokers) -> logs/fleet.log"
  sleep 2
fi

python3 web/server.py "$PANEL_PORT" > logs/panel.log 2>&1 &
track $!
sleep 1

echo
status
echo
echo "panel:  http://127.0.0.1:$PANEL_PORT"
echo "stop:   ./tm2020-sacAI --stop"
if [[ "$INSTANCES" -gt 1 && "$MOCK" -eq 0 ]]; then
  echo
  echo "Each instance needs its OWN running game on its OWN Ubisoft account."
  echo "The same account cannot be logged in twice. Create the accounts by"
  echo "hand, sign each in once in its own Wine prefix, then snapshot it."
  echo "Set each game's Openplanet TMAITelemetry port to the 'plugin' column"
  echo "above."
fi

command -v xdg-open >/dev/null 2>&1 && \
  xdg-open "http://127.0.0.1:$PANEL_PORT" >/dev/null 2>&1 || true
